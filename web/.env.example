# Database (PostgreSQL)
# Production runs on Neon, reached through a Hyperdrive binding — there the
# connection string comes from the binding and this variable is not read at
# runtime. Set it for local development, and as a build-time variable for the
# migration step.
# - Local: postgresql://user:password@localhost:5432/tokens
# - Neon:  postgresql://...@...neon.tech/tokens
DATABASE_URL=postgresql://user:password@localhost:5432/tokens

# Optional: force TLS on or off for the direct (non-Hyperdrive) connection.
# Defaults to "require" when NODE_ENV=production, off otherwise — a local
# Postgres usually has no TLS configured and rejects a required handshake.
# DATABASE_SSL=require

# GitHub OAuth (for authentication)
# Create a GitHub OAuth App at: https://github.com/settings/developers
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Public URL (used for OAuth redirects and CSRF origin checks)
# For local development: http://localhost:3000
# For production: https://your-domain.com
# The origin of this URL is automatically allowed for cookie-authenticated
# mutating requests (creating API tokens, banning accounts, etc.).
NEXT_PUBLIC_URL=http://localhost:3000

# Shared secret for the social-links refresh endpoint. The Workers cron trigger
# runs it in-process, but the route also accepts manual runs and requires this.
CRON_SECRET=replace_with_a_random_string

# Optional: Extra origins allowed for cookie-authenticated mutating requests.
# Comma-separated. Only needed when the app is served from origins other than
# NEXT_PUBLIC_URL (e.g. multiple domains in front of one deployment).
# When set, this REPLACES the default allowlist (https://tokens.ci,
# http://localhost:3000) — but the NEXT_PUBLIC_URL origin is always allowed.
# CSRF_ALLOWED_ORIGINS=https://your-domain.com,https://alt.your-domain.com

# Set at build time only, and only by the deployment allowed to migrate:
# "staging" or "production". Unset, scripts/migrate-prod.ts is a no-op.
# MIGRATE_TARGET=staging
