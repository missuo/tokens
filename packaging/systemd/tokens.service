# Linux systemd *user* service for non-Homebrew installs.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp tokens.service ~/.config/systemd/user/tokens.service
#   # make sure `tokens` is on PATH for the user manager, or use an absolute
#   # ExecStart path below.
#   systemctl --user daemon-reload
#   systemctl --user enable --now tokens
#   # Start at boot without an active login session:
#   sudo loginctl enable-linger "$USER"
#
# Logs:   journalctl --user -u tokens -f
# Status: systemctl --user status tokens
[Unit]
Description=tokens - periodic AI usage submitter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Use an absolute path if `tokens` is not on the user manager's PATH,
# e.g. ExecStart=%h/.cargo/bin/tokens serve  or  /home/linuxbrew/.linuxbrew/bin/tokens serve
ExecStart=tokens serve
Restart=always
RestartSec=30
# Override the default 30-minute cadence if desired:
# Environment=TOKENS_SUBMIT_INTERVAL=30

[Install]
WantedBy=default.target
