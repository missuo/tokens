# Linux systemd *user* service for non-Homebrew installs.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp tokens.service tokens.timer ~/.config/systemd/user/
#   # make sure `tokens` is on PATH for the user manager, or use an absolute
#   # ExecStart path below.
#   systemctl --user daemon-reload
#   systemctl --user enable --now tokens.timer
#   # Start at boot without an active login session:
#   sudo loginctl enable-linger "$USER"
#
# Logs:   journalctl --user -u tokens -f
# Status: systemctl --user status tokens.timer
[Unit]
Description=tokens - AI usage submitter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Use an absolute path if `tokens` is not on the user manager's PATH,
# e.g. ExecStart=%h/.cargo/bin/tokens --no-spinner submit
ExecStart=tokens --no-spinner submit

[Install]
WantedBy=default.target
